{
  "name": "greenwood-demo-adapter-netlify",
  "version": "1.0.0",
  "description": "A demonstration repo for deploying a full-stack Greenwood app with Netlify static hosting and Serverless + Edge functions",
  "author": "Owen Buckley <owen@thegreenhouse.io>",
  "type": "module",
  "license": "ISC",
  "homepage": "https://github.com/ProjectEvergreen/greenwood-demo-adapter-netlify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProjectEvergreen/greenwood-demo-adapter-netlify.git"
  },
  "keywords": [
    "Netlify",
    "Greenwood",
    "WCC",
    "Web Components",
    "Serverless",
    "Edge"
  ],
  "scripts": {
    "dev": "greenwood develop",
    "build": "greenwood build",
    "serve": "greenwood build && greenwood serve",
    "serve:netlify": "greenwood build && netlify dev",
    "start": "npm run serve",
    "postinstall": "patch-package"
  },
   "dependencies": {
    "urlpattern-polyfill": "^10.1.0"
  },
  "devDependencies": {
    "@greenwood/cli": "~0.34.0-alpha.1",
    "@greenwood/plugin-adapter-netlify": "~0.34.0-alpha.1",
    "patch-package": "^8.0.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.50.0"
  }
}
